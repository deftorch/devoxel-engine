{
  "name": "devoxel-engine",
  "version": "0.1.0",
  "description": "Devoxel — a pluggable, WebGPU/WebGL Universal Voxel Framework. Storage, meshing, and rendering are each swappable plugins resolved through a central PluginRegistry.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "imports": {
    "https://esm.sh/bitecs@0.4.0": "bitecs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/deftorch/devoxel-engine"
  },
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check-syntax.js",
    "check-deps": "node scripts/check-bitecs-version.js",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "bitecs": "0.4.0"
  },
  "cdnDependencies": {
    "bitecs": "0.4.0"
  }
}
